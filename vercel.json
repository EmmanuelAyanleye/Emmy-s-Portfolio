{
    "builds": [
        {
            "src": "portfolio/wsgi.py",
            "use": "@vercel/python",
            "config": { 
                "maxLambdaSize": "15mb",
                "runtime": "python3.9"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "portfolio/wsgi.py"
        }
    ],
    "env": {
        "PYTHON_VERSION": "3.9",
        "DATABASE_URL": "postgresql://postgres:Emmy5686.@db.nmsfoiydggaayocpajgs.supabase.co:5432/postgres",
        "DJANGO_SETTINGS_MODULE": "portfolio.settings",
        "ALLOWED_HOSTS": ".vercel.app",
        "DEBUG": "False"
    }
}